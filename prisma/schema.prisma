// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(cuid())
  clerkId                 String?   @unique
  email                   String    @unique
  firstName               String
  lastName                String
  phone                   String?
  passwordHash            String
  role                    UserRole  @default(PET_OWNER)
  isEmailVerified         Boolean   @default(false)
  verificationToken       String?
  verificationTokenExpiry DateTime?
  resetToken              String?
  resetTokenExpiry        DateTime?
  isActive                Boolean   @default(true)
  lastLoginAt             DateTime?
  address                 String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  Pet                     Pet[]
}

model Pet {
  id          String     @id @default(cuid())
  name        String
  species     PetSpecies @default(DOG)
  breed       String?
  dateOfBirth DateTime?
  weight      Float?
  gender      PetGender  @default(MALE)
  size        PetSize    @default(MEDIUM)
  color       String?
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  PetGroomingPreference PetGroomingPreference?
}

model PetGroomingPreference {
  id                  String          @id @default(cuid())
  petId               String          @unique
  pet                 Pet             @relation(fields: [petId], references: [id])
  coatType            PetCoatType?
  temperament         PetTemperament?
  specialInstructions String?
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

enum UserRole {
  PET_OWNER
  GROOMER
  ADMIN
}

enum PetGender {
  MALE
  FEMALE
  UNKNOWN
}

enum PetSize {
  SMALL // 0-25 lbs (0-11 kg)
  MEDIUM // 26-60 lbs (12-27 kg)
  LARGE // 61-90 lbs (28-40 kg)
  EXTRA_LARGE // 90+ lbs (41+ kg)
}

enum PetSpecies {
  DOG
  CAT
}

enum PetCoatType {
  SHORT
  MEDIUM
  LONG
  CURLY
  WIRE
}

enum PetTemperament {
  CALM
  FRIENDLY
  PLAYFUL
  AGGRESSIVE
  SHY
  ANXIOUS
}
